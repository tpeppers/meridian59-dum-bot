{
  // SELL ACROSS BARLOQUE, NOT TO ROQ — a worked overlay on the parity doctrine.
  //
  // This doctrine changes exactly one thing about a fleet: when a character's pack gets heavy,
  // it is sent to store, sell and bank around Barloque rather than dumping the lot on Roq
  // (room 110), the universal fence. The claim it makes, and can be held to: a full pack sold
  // across the smith, the jeweler and the herbalist earns more than the same pack dumped on
  // the one NPC who buys every lane at the standard rate — and Roq's room is behind a tunnel
  // that has been unsafe enough to ban outright, so the multi-stop route is the only one that
  // is both richer AND reachable.
  //
  // It extends keeper-parity, so everything ELSE is the fleet's own behaviour, verbatim: the
  // keeper keeps identity, mortality, survival and recovery on its one-second clock, and DUM
  // holds work, movement and economy but changes nothing until a pack fills. That isolation is
  // the point — if kills-per-hour or deaths move under this doctrine, it is the sell circuit
  // that moved them, because nothing else is different.
  //
  // NO FLEET NAME HERE, deliberately — tools/dum-guard.mjs refuses one. To run it against a
  // live fleet, extend it in doctrines/local/ with a "fleet:" line, or pass --set fleet=<name>.

  "extends": "keeper-parity.jsonc",

  "name": "barloque sell circuit",
  "why": "test whether routing a full pack across the Barloque specialists beats selling it to Roq, on shillings banked per hour, changing nothing else",

  // WHICH MERCHANT IS IN WHICH ROOM IS NOT AN ORDER, AND IS NO LONGER IN THIS FILE.
  //
  // The three specialists, the keep list, Obert Cair'bre's vault and the First Royal Bank of
  // Tos are facts about Barloque — like the room flags or the nutrition table — and they now
  // live in src/decide/rules/sellrun.mjs as BARLOQUE_STOPS, SELL_KEEP, BARLOQUE_VAULT and
  // TOS_BANK, each with the kod citation or the measured hop count for why it is what it is.
  // Read them there; the tests assert against those constants rather than against this file.
  //
  // What is left here is the part that IS an order: whether to go at all, and how full a pack
  // has to be first. That is the only half an operator should be changing without a commit.
  //
  // THIS SPLIT WAS NOT THE ORIGINAL ARRANGEMENT, and the reason it changed is worth keeping.
  // Every list used to be restated here — and the live prod doctrine does not descend from
  // this file. It descends from castle-victoria, which descends from survive. So switching
  // selling on for the real fleet meant copying four lists into a gitignored local doctrine,
  // where they would drift from the file the tests assert against, silently. The first symptom
  // of that drift would have been a merchant buying the Duke's free food.
  //
  // Any of them can still be overridden here or in a local doctrine. `"vault": null` and
  // `"bank": null` decline those stops outright, which is a different instruction from saying
  // nothing about them.
  "sellrun": {
    "on": true,

    "trigger": {
      // A pack of this many items is worth the trip, and the trip is now eleven steps: the
      // vault, three shops, the bank and the walk home, about forty room hops. Tune it against
      // the fleet's real carry allowance — the parity fleet runs max_carry 14 and the castle
      // doctrines run 50, so this number means something quite different under each.
      "carry_at": 24,
      // Leave the "go when broke" trigger off; a heavy pack is the reason to go.
      "broke_under": 0,
      // Do not march a hurt character across town — below this the keeper's ladder should act.
      "min_health": 0.8
    },

    "min_price": 1,

    // The per-character cooldown that keeps the errand from re-firing every 30s tick. With the
    // vault and bank stops the circuit is eleven steps rather than seven, so this is the window
    // a character is NOT hunting — worth having generous. A pack that fills again inside it
    // waits, which is the correct trade: the whole claim of this doctrine is that one big trip
    // beats several small ones.
    "cooldown_ms": 2400000,
    "travel_timeout_ms": 240000,
    "return_home": true
  }
}

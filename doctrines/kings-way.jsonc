{
  "extends": "survive.jsonc",
  "name": "King's Way and Castle Victoria shift",
  "why": "work The King's Way for frogmen with a quarter in Castle Victoria's main room, wielding the short sword the skill is for, with roaming off because a level-150 room sits one door from each destination",

  "claim": {
    "movement": "bot",
    "work": "bot",
    "economy": "bot",
    "lease_ms": 600000
  },

  "cadence": {
    "character_ms": 30000,
    "fleet_ms": 120000,
    "backoff_ms": 60000
  },

  "strategies": {
    "enabled": true,
    // `vs-skeletons` is deliberately gone and `short-swording` replaces it. They are both
    // weapon orders and a unit holding both would be told two things; short swording wins
    // the tie in code, but selecting both would still be a doctrine that cannot say what
    // it wants.
    //
    // `check-cv-crate` is gone with the rest of the Castle Victoria work: the crate is
    // under Castle Victoria and this fleet is no longer anywhere near it. Leaving it
    // selected would send whichever unit came up in the rotation on a walk across the
    // world and back, for a crate whose expected value is about forty shillings.
    "defaults": ["create-weapons", "short-swording", "create-food", "sell-and-bank", "max-weapons", "buy-food", "buy-weapons", "buy-reagents", "accumulate-in-vault", "farm-cleanup"],
    "settings": {
      "short-swording": {
        // 2601 first: it is the room with the renewable level-75 skeleton generator, and
        // the quarry list is resolved against these in order. 2600 is kept so a character
        // too small for a skeleton falls through to the spectral mummy rather than being
        // left unplaced. 2602 is NOT here and must not be added — thrashers, level 150.
        "rooms": [2601, 2600],
        "hunt": ["skeleton", "spectral mummy"],
        "town_trips": true
      },
      "sell-and-bank": {
        "bank_above": 3000,
        "walking_money": 1000,
        "max_carry": 50,
        "sell_at_load": 0.95,
        "sell_when_broke": false,
        "broke_under": 500,
        "broke_stacks": 8
      },
      "accumulate-in-vault": {
        "items": [
          "dark angel feather",
          "Inky-cap mushroom",
          "blue dragon scale",
          "arrows",
          "nerudite arrows"
        ]
      }
    }
  },

  // 75/25: THE KING'S WAY, WITH THE REMAINDER IN CASTLE VICTORIA'S MAIN ROOM.
  //
  // A frogman is level 70 at rating 510 — above every character here, so it still advances
  // them. 576 is the only King's Way room with frogmen: 575 shares the name and makes
  // giant rats, and 552 The Great Ocean makes frogmen at 20% alongside mollusk creatures
  // at level 150, so it is the room somebody reaches for and it is not in HUNT_ROOMS.
  //
  // THE CRYPT STATION IS GONE BECAUSE ITS ROUTE KILLED SOMEBODY, not because 2601 was bad.
  // The path to the Marion crypts runs through the Ancient Graveyard of Brax, where a
  // narthyl worm is level 120 — a creature nothing in this fleet may fight, so a character
  // meeting one on the way can only run, and travel doctrine is "the way out is through".
  // A level-53 character was killed on that road on 2026-08-13, having survived the
  // destination perfectly well — the room was never the problem, the corridor was.
  //
  // 38 IS THE MAIN ROOM AND 39 IS ONLY AN OVERFLOW VALVE. `max` fills 38 first and sends
  // the rest upstairs, which is what overflow means — a share alone would put a fixed
  // proportion in each room however crowded the first got. 8 leaves headroom under 38's
  // skeleton cap of 10 so the room is not being fought over. At the current 75/25 the
  // valve never opens: five units go to 38 and none to 39.
  //
  // AND 39 PAYS ALMOST NOBODY. Its battered skeleton is level 60 and eighteen of these
  // characters are 60, and a kill advances only while the creature's level is strictly
  // above max health. It is a legitimate place to put an overflowing character, not a
  // good one — if the valve is opening regularly, the fleet needs a third room, not this.
  //
  // THE GRAVEYARD STATION EXISTS ONLY WHILE THE GRAVEYARD DOES. Room 70 generates nothing
  // outside a 35-minute window in every 120 — `TryCreateMonster` is gated on the game hour
  // — so `when: "night"` is not a preference, it is the difference between a shift and an
  // empty field. It is FIRST in the list so the window gets its pick while it is open, and
  // when it closes the station simply is not there and those units are allocated to the
  // King's Way again on the next fleet tick. Nobody has to do anything at either edge.
  //
  // ORDER IS WHO GIVES THE UNITS UP. Allocation runs down this list, so the graveyard is
  // first and Castle Victoria second — which means the night window draws from the KING'S
  // WAY contingent and the castle keeps its quarter throughout. With the King's Way listed
  // second instead, the graveyard came out of the castle's share and left it empty for the
  // whole window, which is not what "some of the frogman hunters switch" means.
  //
  // 35% rather than more, because the room is 85% zombie and only 15% skeleton, and a
  // zombie is level 55 — it advances nobody here. The window is worth a third of the fleet
  // for its skeletons, not the whole of it. And the walk is real: at a 120-second fleet
  // tick a unit spends part of its window travelling, which is the cost of a shift that
  // re-forms every two hours.
  //
  // A NIGHT STATION IS SHUT WHEN THE CLOCK IS UNKNOWN. `world_clock` is null until an
  // operator has watched a window begin and run `m59-dayclock.mjs --start-now`; that is a
  // different fact from "it is daytime" and is deliberately not guessed at.
  //
  // FROGMEN CARRY +80 KARMA AND EVERYTHING ELSE HERE IS NEGATIVE. "Killing someone with
  // 100 karma is a -100 karma act" (player.kod:6559), bounded to 150 a kill, so this
  // shift drives the fleet's karma down. Recorded rather than guarded because karma gates
  // only Qor and Shal'ille spells (spell.kod:481-495) and nobody here holds one; create
  // food and create weapon are Kraanan and ungated. Revisit if that changes.
  "shift": {
    "on": true,
    "stations": [
      { "room": 70, "hunt": "skeleton", "share": 0.35, "when": "night" },
      { "room": 38, "hunt": "skeleton", "share": 0.25, "max": 8 },
      { "room": 576, "hunt": "frogman", "share": 0.75 },
      { "room": 39, "hunt": "battered skeleton" }
    ],
    "rest_below": 0.75,
    "flee_below": 0.35,
    "fight_above_vigor": 180,
    "use_safe_spots": true
  },

  // EVERY CASTLE VICTORIA EFFORT IS OFF, and all three of these have to be off together.
  // The shift assigns rooms 38/39, the crate walks a unit to room 41, and the placement
  // spread pins the same two castle rooms — leaving any one of them on would drag part of
  // the fleet back across the world while the crypt rule sent it the other way, and the
  // two would fight every tick.
  "castle_victoria": { "shift": false },
  "crate": { "check": false },
  "placement": { "spread": false, "rooms": [] },

  "weapons": {
    "preset": "shortSwording",
    "provision": {
      "enabled": false,
      "threshold": "short sword",
      "room": null,
      "staging_only": false,
      "cast_when_mana": true,
      "mana_cost": 15
    }
  },

  "food": {
    "min_items": 1,
    "mana_cost": 10,
    "elderberry_per_cast": 2,
    "herbs_per_cast": 2
  },

  "record": {
    "full_observations": false
  },

  "graveyard": { "shift": false },
  "prey": { "choose": false, "flee_below": 0.35 }
}

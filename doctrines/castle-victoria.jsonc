{
  "extends": "survive.jsonc",
  "name": "Castle Victoria undead shift",
  "why": "run the whole fleet hands-off across Castle Victoria's two undead generators while equipment, food, and the crate remain independently selectable strategies",

  "claim": {
    "movement": "bot",
    "work": "bot",
    "economy": "bot",
    "lease_ms": 600000
  },

  "cadence": {
    "character_ms": 30000,
    "fleet_ms": 120000,
    "backoff_ms": 60000
  },

  "strategies": {
    "enabled": true,
    // Spread Out is deliberately absent: Castle patrols retain their quarry and safety
    // posture without being forced into different rooms or different wall squares.
    // Farm delivery is opt-in too. A Castle seller otherwise follows its necessary town
    // loop with an apothecary-and-six-recipient circuit; the bounded local almoner already
    // shares the same reagents without turning a high-yield farmer into a long-haul courier.
    "defaults": ["create-weapons", "vs-skeletons", "check-cv-crate", "create-food", "sell-and-bank", "supply-limited-farming", "inky-reserve", "max-weapons", "buy-food", "buy-weapons", "buy-reagents", "accumulate-in-vault", "farm-cleanup"],
    "settings": {
      // ONE TRIP, NOT TWO. Read off the counter: elderberry 28sh, herbs 14sh, so shipping
      // out with 40 of each is 1,680sh before a loaf or a piece of armour. At the old
      // 3000/1000 a character banked down to a float that could not fund that, and every
      // outfitting became two round trips. Measured across the fleet while that held, only
      // 23% of active time was spent FIGHTING — nine of twenty-one were in transit or at a
      // counter at any moment, and kills ran ~18 per 30 minutes against a target of 30.
      //
      // The cost is carried risk, and it is the whole content of bank_above: what is in
      // the pack drops where a character dies and a bank balance does not.
      //
      // KEEP walking_money LOW. It is not the float a character is topped up TO — it is
      // the floor restockReagents refuses to spend below, "so it can never eat the money
      // a character needs to get home". Raising it to 2,500 to cover an outfitting was
      // exactly backwards and blocked the spending it looked like it enabled: measured on
      // the live fleet, purses of 0 to 586 against bank balances of 10,000 to 36,000,
      // restocks arriving as 150-shilling dribbles, and trading at 54% of active time
      // against 17% fighting. What buys an outfitting is the BAND between the two — 4,000
      // over 400 is 3,600, one full reagent fill plus a piece of armour.
      "sell-and-bank": {
        "bank_above": 4000,
        "walking_money": 400,
        "max_carry": 50,
        "sell_at_load": 0.95,
        "sell_when_broke": false,
        "broke_under": 500,
        "broke_stacks": 8
      },
      "accumulate-in-vault": {
        "items": [
          "dark angel feather",
          "Inky-cap mushroom",
          "blue dragon scale",
          "arrows",
          "nerudite arrows"
        ]
      }
    }
  },

  "castle_victoria": {
    "shift": true,
    "rooms": { "downstairs": 38, "upstairs": 39 },
    // DOWNSTAIRS (38), FOR THE FULL LEVEL-75 SKELETON. This was 1 — everybody upstairs —
    // on the grounds that "downstairs has no keeper-detectable safe wall; upstairs has
    // proven walls and level-60 prey that still advances the whole fleet". Both halves of
    // that have stopped being true, so it is corrected here rather than left standing as a
    // comment nobody re-measured.
    //
    // A KILL PAYS ONLY WHILE THE CREATURE'S LEVEL IS STRICTLY ABOVE MAX HEALTH, and max
    // health IS the level here. Eighteen of twenty-one characters are now at exactly 60,
    // which is the battered skeleton's level — so upstairs pays those eighteen NOTHING,
    // indefinitely, while reporting kills the whole time. That is precisely the failure
    // `yieldCheck` exists to name: everything works and none of it is worth anything. The
    // full skeleton is level 75 and still advances every character here.
    //
    // AND THE SAFE-WALL CLAIM IS NOW BACKWARDS. Measured against
    // substrate/m59-safespots.json on 2026-08-13: room 39 has 132 squares tested and ZERO
    // that held without later failing; room 38 has 147 tested and three still standing
    // (24,4 / 12,4 / 27,4). Neither room is comfortable — a discredited square is
    // discredited for ever, so both records are mostly wreckage — but downstairs is the
    // one with anything left.
    //
    // THE PRECONDITION IS THE ENGAGEMENT CEILING, and it is enforced rather than assumed:
    // `refuseEngagement` refuses a creature whose level exceeds round(max_health * 1.5), so
    // a level-75 skeleton needs max health >= 50. The whole fleet clears it (lowest 53).
    // A YOUNGER FLEET MUST SET THIS BACK TO 1 — under 50 max health every character would
    // refuse the only prey its assigned room generates and stand in it doing nothing.
    "upstairs_share": 0,
    "retreat_to": 52,
    "rest_below": 0.75,
    "flee_below": 0.35,
    "fight_above_vigor": 180,
    "use_safe_spots": true
  },

  "weapons": {
    "preset": "strongestToWeakest",
    "provision": {
      "enabled": false,
      "threshold": "axe",
      "room": null,
      "staging_only": false,
      "cast_when_mana": true,
      "mana_cost": 15
    }
  },

  "food": {
    "min_items": 1,
    "mana_cost": 10,
    "elderberry_per_cast": 2,
    "herbs_per_cast": 2
  },

  "record": {
    "full_observations": false
  },

  "crate": {
    "check": true,
    "zone": [2, 38, 39, 40],
    "quorum": 3,
    "room": 41,
    "square": { "col": 6, "row": 10 },
    "probe_every_ms": 1800000,
    "min_health": 0.8,
    "min_level": 30,
    "return_after": true,
    "travel_timeout_ms": 180000,
    "walk_timeout_ms": 90000
  },

  "graveyard": { "shift": false },
  "placement": { "spread": false, "rooms": [38, 39] },
  "prey": { "choose": false, "flee_below": 0.35, "max_threat_over": 28 }
}

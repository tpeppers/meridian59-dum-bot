{
  "extends": "survive.jsonc",
  "name": "King's Way and Marion crypt shift",
  "why": "work The King's Way for frogmen with a quarter of the fleet left in the Marion crypts, wielding the short sword the skill is for, with roaming off because both regions have a level-150 room nearby",

  "claim": {
    "movement": "bot",
    "work": "bot",
    "economy": "bot",
    "lease_ms": 600000
  },

  "cadence": {
    "character_ms": 30000,
    "fleet_ms": 120000,
    "backoff_ms": 60000
  },

  "strategies": {
    "enabled": true,
    // `vs-skeletons` is deliberately gone and `short-swording` replaces it. They are both
    // weapon orders and a unit holding both would be told two things; short swording wins
    // the tie in code, but selecting both would still be a doctrine that cannot say what
    // it wants.
    //
    // `check-cv-crate` is gone with the rest of the Castle Victoria work: the crate is
    // under Castle Victoria and this fleet is no longer anywhere near it. Leaving it
    // selected would send whichever unit came up in the rotation on a walk across the
    // world and back, for a crate whose expected value is about forty shillings.
    "defaults": ["create-weapons", "short-swording", "create-food", "sell-and-bank", "max-weapons", "buy-food", "buy-weapons", "buy-reagents", "accumulate-in-vault", "farm-cleanup"],
    "settings": {
      "short-swording": {
        // 2601 first: it is the room with the renewable level-75 skeleton generator, and
        // the quarry list is resolved against these in order. 2600 is kept so a character
        // too small for a skeleton falls through to the spectral mummy rather than being
        // left unplaced. 2602 is NOT here and must not be added — thrashers, level 150.
        "rooms": [2601, 2600],
        "hunt": ["skeleton", "spectral mummy"],
        "town_trips": true
      },
      "sell-and-bank": {
        "bank_above": 3000,
        "walking_money": 1000,
        "max_carry": 50,
        "sell_at_load": 0.95,
        "sell_when_broke": false,
        "broke_under": 500,
        "broke_stacks": 8
      },
      "accumulate-in-vault": {
        "items": [
          "dark angel feather",
          "Inky-cap mushroom",
          "blue dragon scale",
          "arrows",
          "nerudite arrows"
        ]
      }
    }
  },

  // 75/25: THE KING'S WAY FIRST, THE CRYPT KEPT AS THE SECOND STATION.
  //
  // A frogman is level 70 at rating 510 — above every character here, so it still advances
  // them, and slightly gentler than the crypt skeleton's 525. Room 576 is also a much
  // kinder neighbourhood: its worst neighbour is 578 with trolls, where 2601 is one door
  // from 2602 and thrashers at level 150.
  //
  // TWO ROOMS NAMED "THE KING'S WAY" AND ONLY ONE OF THEM HAS FROGMEN. 575 generates giant
  // rats and baby spiders, which advance nobody here. And 552 The Great Ocean generates
  // frogmen too — at 20%, alongside mollusk creatures at level 150 and 80% — so it is the
  // room somebody reaches for and it is not in HUNT_ROOMS at all.
  //
  // FROGMEN CARRY +80 KARMA AND EVERYTHING THIS FLEET HAS KILLED SO FAR WAS NEGATIVE.
  // "Killing someone with 100 karma is a -100 karma act" (player.kod:6559), bounded to
  // 150 a kill, so a shift on frogmen drives the whole fleet's karma down. It is recorded
  // rather than guarded because it costs this fleet nothing: karma gates only Qor and
  // Shal'ille spells (spell.kod:481-495), and nobody here holds one — the create food and
  // create weapon everything depends on are Kraanan and ungated. A fleet that later learns
  // a Shal'ille spell would need this revisited.
  "shift": {
    "on": true,
    "stations": [
      { "room": 576, "hunt": "frogman", "share": 0.75 },
      { "room": 2601, "hunt": "skeleton", "share": 0.25 }
    ],
    "rest_below": 0.75,
    "flee_below": 0.35,
    "fight_above_vigor": 180,
    "use_safe_spots": true
  },

  // EVERY CASTLE VICTORIA EFFORT IS OFF, and all three of these have to be off together.
  // The shift assigns rooms 38/39, the crate walks a unit to room 41, and the placement
  // spread pins the same two castle rooms — leaving any one of them on would drag part of
  // the fleet back across the world while the crypt rule sent it the other way, and the
  // two would fight every tick.
  "castle_victoria": { "shift": false },
  "crate": { "check": false },
  "placement": { "spread": false, "rooms": [] },

  "weapons": {
    "preset": "shortSwording",
    "provision": {
      "enabled": false,
      "threshold": "short sword",
      "room": null,
      "staging_only": false,
      "cast_when_mana": true,
      "mana_cost": 15
    }
  },

  "food": {
    "min_items": 1,
    "mana_cost": 10,
    "elderberry_per_cast": 2,
    "herbs_per_cast": 2
  },

  "record": {
    "full_observations": false
  },

  "graveyard": { "shift": false },
  "prey": { "choose": false, "flee_below": 0.35 }
}
